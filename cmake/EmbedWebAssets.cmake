# Bakt de statische webbestanden in een C++-bronbestand (geen runtime-bestanden, geen CDN).
# gebruik: embed_web_assets(<uitvoer.cpp> <map> <bestand>...)
# Een item mag ook <naam>=<absoluut pad> zijn: het bestand wordt dan onder <naam> ingebakken (bv. packaging/aagames-games.json).
function(embed_web_assets OUT DIR)
  set(body "// Gegenereerd door cmake/EmbedWebAssets.cmake uit src/ravengund/web/. Niet bewerken.\n#include \"ravengun/web/web_core.hpp\"\n#include <cstring>\nnamespace ravengun::web {\nnamespace {\nconst Asset kAssets[] = {\n")
  foreach(item ${ARGN})
    if(item MATCHES "^([^=]+)=(.+)$")
      set(name "${CMAKE_MATCH_1}")
      set(src "${CMAKE_MATCH_2}")
    else()
      set(name "${item}")
      set(src "${DIR}/${item}")
    endif()
    file(READ "${src}" content)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${src}")
    if(name MATCHES "\\.html$")
      set(ct "text/html; charset=utf-8")
    elseif(name MATCHES "\\.css$")
      set(ct "text/css; charset=utf-8")
    elseif(name MATCHES "\\.js$")
      set(ct "text/javascript; charset=utf-8")
    elseif(name MATCHES "\\.json$")
      set(ct "application/json; charset=utf-8")
    else()
      set(ct "application/octet-stream")
    endif()
    string(APPEND body "  {\"${name}\", \"${ct}\", R\"RGWEB(${content})RGWEB\"},\n")
  endforeach()
  string(APPEND body "};\n}  // namespace\nconst Asset* find_asset(std::string_view path) {\n  for (const Asset& a : kAssets) if (path == a.path) return &a;\n  return nullptr;\n}\n}  // namespace ravengun::web\n")
  file(WRITE "${OUT}.tmp" "${body}")
  execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different "${OUT}.tmp" "${OUT}")
endfunction()
