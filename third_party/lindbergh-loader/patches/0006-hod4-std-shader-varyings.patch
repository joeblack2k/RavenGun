 }
 
+// RavenGun: HOTD4 fetches glShaderSourceARB through glXGetProcAddressARB (one call site, 0x081b6fb7 in Rev C), which the loader
+// does not intercept for this game. patch.c points that call here: glShaderSourceARB goes through gl_ShaderSourceARB (and so
+// hod4StdVertexShaderFix), every other name to the normal lookup. Both functions realign the stack: the game calls with a
+// 4-byte aligned stack (librg-stackalign does this for the normal lookup's results).
+__attribute__((force_align_arg_pointer)) static void hod4ShaderSourceARB(GLhandleARB shaderObj, GLsizei count,
+                                                                         const GLcharARB **const string, const GLint *length)
+{
+    gl_ShaderSourceARB(shaderObj, count, string, length);
+}
+
+__attribute__((force_align_arg_pointer)) void *hod4GetProcAddressARB(const unsigned char *procName)
+{
+    if (procName != NULL && strcmp((const char *)procName, "glShaderSourceARB") == 0)
+        return (void *)hod4ShaderSourceARB;
+    return (void *)glXGetProcAddressARB(procName);
+}
