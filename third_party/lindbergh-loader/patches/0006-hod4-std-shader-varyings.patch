+// RavenGun: HOTD4's standard shaders (fs/dat/std.dat0 + std.dat1, one program per material) do not link on Mesa. The fragment
+// shader (with the loader's own Mesa patch) copies nnglvTexCoord01/23/45/67 into globals at file scope, so it always reads
+// those varyings, plus nnglvViewPositionFog; the vertex shader only writes the ones its material uses. GLSL 1.10/1.20 makes a
+// varying that the fragment shader reads but the vertex shader never writes a link error ("fragment shader varying ... not
+// written by vertex shader"); NVIDIA accepts it. Every material program then fails to link and the game draws the scene
+// without its shader: the wrong colours (raw base/normal maps, purple-blue walls). Measured 2026-10-21: all 1599 programs
+// of a chapter 1 run fail to link on Mesa; with these five varyings set to 0 at the start of the vertex shader's main()
+// (the shader's own writes follow and win) all 1599 link.
+static bool hod4StdVertexShaderFix(GLhandleARB shaderObj, GLsizei count, const GLcharARB **const string, const GLint *length)
+{
+    static const char key[] = "void main( void )\r\n{\r\n";
+    static const char init[] = "\tnnglvViewPositionFog = vec4(0.0);\r\n\tnnglvTexCoord01 = vec4(0.0);\r\n"
+                               "\tnnglvTexCoord23 = vec4(0.0);\r\n\tnnglvTexCoord45 = vec4(0.0);\r\n"
+                               "\tnnglvTexCoord67 = vec4(0.0);\r\n";
+    if (gGrp != GROUP_HOD4 || count != 1 || string == NULL || *string == NULL)
+        return false;
+    size_t len = (length != NULL && length[0] >= 0) ? (size_t)length[0] : strlen(*string);
+    char *src = strndup(*string, len);
+    if (src == NULL)
+        return false;
+    char *at = strstr(src, key);
+    if (strstr(src, "Standard Vertex Shader") == NULL || strstr(src, "varying vec4 nnglvViewPositionFog;") == NULL ||
+        strstr(src, "varying half4 nnglvTexCoord67;") == NULL || at == NULL)
+    {
+        free(src);
+        return false;
+    }
+    size_t head = (size_t)(at - src) + strlen(key);
+    char *out = malloc(len + sizeof(init));
+    if (out == NULL)
+    {
+        free(src);
+        return false;
+    }
+    memcpy(out, src, head);
+    memcpy(out + head, init, sizeof(init) - 1);
+    memcpy(out + head + sizeof(init) - 1, src + head, len - head);
+    out[len + sizeof(init) - 1] = 0;
+    const GLcharARB *final_string = out;
+    glShaderSourceARB(shaderObj, 1, &final_string, NULL);
+    free(out);
+    free(src);
+    return true;
+}
+
 void gl_ShaderSourceARB(GLhandleARB shaderObj, GLsizei count, const GLcharARB **const string, const GLint *length)
 {
+    if (hod4StdVertexShaderFix(shaderObj, count, string, length))
+        return;
+
     if (gGrp != GROUP_HUMMER && gId != SEGA_RACE_TV)
     {
         glShaderSourceARB(shaderObj, count, string, length);
