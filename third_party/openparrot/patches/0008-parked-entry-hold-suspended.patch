+			// RavenGun modification: hold the primary thread suspended at the entry
+			// point and put the original entry bytes back BEFORE any DLL is loaded.
+			// A core that ignores TP_LOADER_MANAGED_INIT (the closed TeknoParrot.dll
+			// 1.0.0.3761) hooks the entry point from DllMain in the remote thread,
+			// one byte at a time (E9, then rel32). A thread still spinning on EB FE
+			// can then execute E9 FE xx xx xx, a jump to entry+5+0x??FE into the
+			// middle of an instruction (measured: Mario Kart DX, #UD at 0x8C753D =
+			// 0x8C6E3F + 0x6FE). The core would also save our EB FE as the "original"
+			// code and spin forever after its own init. Suspended at the entry point
+			// with the real bytes in place, both problems are gone; the final
+			// ResumeThread below releases the thread.
+			bool heldAtEntryPoint = false;
+			for (int attempt = 0; attempt < 40 && !heldAtEntryPoint; ++attempt)
+			{
+				if (SuspendThread(pi.hThread) == static_cast<DWORD>(-1))
+					break;
+				CONTEXT entryContext = {};
+				entryContext.ContextFlags = CONTEXT_CONTROL;
+				if (GetThreadContext(pi.hThread, &entryContext))
+				{
+#ifdef _M_IX86
+					const DWORD_PTR ip = entryContext.Eip;
+#else
+					const DWORD_PTR ip = entryContext.Rip;
+#endif
+					if (ip == reinterpret_cast<DWORD_PTR>(parkedEntryPoint))
+					{
+						heldAtEntryPoint = true;
+						break;
+					}
+				}
+				ResumeThread(pi.hThread);
+				Sleep(250);
+			}
+			if (!heldAtEntryPoint)
+			{
+				wprintf(L"Primary thread did not reach the parked entry point! (0x%X)\n",
+					GetLastError());
+				TerminateProcess(pi.hProcess, 0);
+				return 1;
+			}
+
+			SIZE_T restored = 0;
+			if (!WriteProcessMemory(pi.hProcess, parkedEntryPoint,
+				parkedOriginalEntryPoint, sizeof(parkedOriginalEntryPoint), &restored) ||
+				restored != sizeof(parkedOriginalEntryPoint))
+			{
+				wprintf(L"Failed to restore parked game entry point! (0x%X)\n",
+					GetLastError());
+				TerminateProcess(pi.hProcess, 0);
+				return 1;
+			}
+			FlushInstructionCache(pi.hProcess, parkedEntryPoint,
+				sizeof(parkedOriginalEntryPoint));
+			wprintf(L"Primary thread suspended at the entry point; original entry bytes restored before loading the core.\n");
 		}
