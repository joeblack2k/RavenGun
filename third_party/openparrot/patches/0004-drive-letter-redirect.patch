diff -ruN a/OpenParrot/src/Functions/Ring_amLib/amJvs.cpp b/OpenParrot/src/Functions/Ring_amLib/amJvs.cpp
--- a/OpenParrot/src/Functions/Ring_amLib/amJvs.cpp	2026-09-11 14:23:52.000000000 +0200
+++ b/OpenParrot/src/Functions/Ring_amLib/amJvs.cpp	2026-10-12 10:59:25.294891907 +0200
@@ -57,6 +57,69 @@
 	HANDLE hTemplateFile);
 static LPCreateFileW  __CreateFileW = NULL;
 
+typedef BOOL(WINAPI *LPCreateDirectoryA)(LPCSTR lpPathName, LPSECURITY_ATTRIBUTES lpSecurityAttributes);
+static LPCreateDirectoryA __CreateDirectoryA = NULL;
+
+typedef BOOL(WINAPI *LPCreateDirectoryW)(LPCWSTR lpPathName, LPSECURITY_ATTRIBUTES lpSecurityAttributes);
+static LPCreateDirectoryW __CreateDirectoryW = NULL;
+
+// RavenGun 0004: schijfletter-herleiding (zie het commentaarblok van 0004-...patch).
+// Een pad "<L>:\\rest" (of "<L>:/rest") wordt herleid naar ".\\TeknoParrot\\<L>\\rest", cwd-relatief,
+// net zoals de gesloten TeknoParrot-kern. C: (de prefix) en Z: (de Wine-root waar de exe zelf op
+// staat) worden nooit herleid. De basismap ".\\TeknoParrot\\<L>" wordt vast aangemaakt, zodat de
+// eerste map-aanmaak van de game lukt (anders loopt zijn recursieve mkdir leeg op een pad zonder
+// backslash -- dat is de null-write waarmee Gashaaaan na ~5 s met 0xC0000005 crasht).
+static bool rgRedirectA(LPCSTR in, char* out, size_t outsz)
+{
+	if (!in || !in[0]) return false;
+	char L = in[0];
+	if (L >= 'a' && L <= 'z') L = (char)(L - 'a' + 'A');
+	if (L < 'A' || L > 'Z') return false;
+	if (in[1] != ':') return false;                      // in[1] != 0, dus in[2] is veilig te lezen
+	if (in[2] != '\\' && in[2] != '/') return false;
+	if (L == 'C' || L == 'Z') return false;
+	const char* rest = in + 3;
+	size_t rl = strlen(rest);
+	if (16 + rl + 1 > outsz) return false;               // ".\TeknoParrot\" (14) + <L> + "\" = 16
+	if (__CreateDirectoryA)
+	{
+		char base[] = ".\\TeknoParrot\\?";              // 15 tekens, '?' op index 14
+		__CreateDirectoryA(".\\TeknoParrot", NULL);
+		base[14] = L;
+		__CreateDirectoryA(base, NULL);
+	}
+	memcpy(out, ".\\TeknoParrot\\", 14);
+	out[14] = L;
+	out[15] = '\\';
+	memcpy(out + 16, rest, rl + 1);
+	return true;
+}
+static bool rgRedirectW(LPCWSTR in, wchar_t* out, size_t outcch)
+{
+	if (!in || !in[0]) return false;
+	wchar_t L = in[0];
+	if (L >= L'a' && L <= L'z') L = (wchar_t)(L - L'a' + L'A');
+	if (L < L'A' || L > L'Z') return false;
+	if (in[1] != L':') return false;
+	if (in[2] != L'\\' && in[2] != L'/') return false;
+	if (L == L'C' || L == L'Z') return false;
+	const wchar_t* rest = in + 3;
+	size_t rl = wcslen(rest);
+	if (16 + rl + 1 > outcch) return false;
+	if (__CreateDirectoryW)
+	{
+		wchar_t base[] = L".\\TeknoParrot\\?";
+		__CreateDirectoryW(L".\\TeknoParrot", NULL);
+		base[14] = L;
+		__CreateDirectoryW(base, NULL);
+	}
+	memcpy(out, L".\\TeknoParrot\\", 14 * sizeof(wchar_t));
+	out[14] = L;
+	out[15] = L'\\';
+	memcpy(out + 16, rest, (rl + 1) * sizeof(wchar_t));
+	return true;
+}
+
 
 LPCSTR emuPort = "\\\\.\\pipe\\teknoparrot_jvs";
 LPCWSTR emuPortW = L"\\\\.\\pipe\\teknoparrot_jvs";
@@ -166,6 +229,19 @@
 				hTemplateFile);
 		}
 	}
+	{
+		char rgpath[520];
+		if (rgRedirectA(lpFileName, rgpath, sizeof(rgpath)))
+		{
+			return __CreateFileA(rgpath,
+				dwDesiredAccess,
+				dwShareMode,
+				lpSecurityAttributes,
+				dwCreationDisposition,
+				dwFlagsAndAttributes,
+				hTemplateFile);
+		}
+	}
 	HANDLE hResult = __CreateFileA(lpFileName,
 		dwDesiredAccess,
 		dwShareMode,
@@ -234,6 +310,19 @@
 		}
 	}
 
+	{
+		wchar_t rgpath[520];
+		if (rgRedirectW(lpFileName, rgpath, 520))
+		{
+			return __CreateFileW(rgpath,
+				dwDesiredAccess,
+				dwShareMode,
+				lpSecurityAttributes,
+				dwCreationDisposition,
+				dwFlagsAndAttributes,
+				hTemplateFile);
+		}
+	}
 	HANDLE hResult = __CreateFileW(lpFileName,
 		dwDesiredAccess,
 		dwShareMode,
@@ -417,6 +506,24 @@
 	return true;
 }
 
+// RavenGun 0004: dezelfde schijfletter-herleiding voor het aanmaken van mappen. De crash van
+// Gashaaaan zit juist hier -- in een recursieve CreateDirectoryA (mkdir -p) op F:\\..., niet in
+// CreateFileA -- dus CreateFileA/W alleen voorkomt hem niet; CreateDirectoryA/W moet mee.
+BOOL __stdcall Hook_CreateDirectoryA(LPCSTR lpPathName, LPSECURITY_ATTRIBUTES lpSecurityAttributes)
+{
+	char rgpath[520];
+	if (rgRedirectA(lpPathName, rgpath, sizeof(rgpath)))
+		return __CreateDirectoryA(rgpath, lpSecurityAttributes);
+	return __CreateDirectoryA(lpPathName, lpSecurityAttributes);
+}
+BOOL __stdcall Hook_CreateDirectoryW(LPCWSTR lpPathName, LPSECURITY_ATTRIBUTES lpSecurityAttributes)
+{
+	wchar_t rgpath[520];
+	if (rgRedirectW(lpPathName, rgpath, 520))
+		return __CreateDirectoryW(rgpath, lpSecurityAttributes);
+	return __CreateDirectoryW(lpPathName, lpSecurityAttributes);
+}
+
 #define __XHOOKn(mod, name)	\
 	MH_CreateHookApi(L ## mod, #name, &Hook_##name, (void**)&__##name)
 
@@ -448,6 +555,8 @@
 
 	__XHOOKn("kernel32.dll", CreateFileA);
 	__XHOOKn("kernel32.dll", CreateFileW);
+	__XHOOKn("kernel32.dll", CreateDirectoryA);
+	__XHOOKn("kernel32.dll", CreateDirectoryW);
 	__XHOOKn("kernel32.dll", GetCommModemStatus);
 	MH_EnableHook(MH_ALL_HOOKS);
 });
