--- a/deps/inc/injector/hooking.hpp
+++ b/deps/inc/injector/hooking.hpp
@@ -133,7 +133,7 @@
     {
         public:
             // Save buffer at @addr with @size and virtual protect @vp and then overwrite it with @value
-            void write(memory_pointer_tr addr, void* value, size_t size, bool vp)
+            void write(memory_pointer_tr addr, const void* value, size_t size, bool vp)
             {
                 this->save(addr, size, vp);
                 return WriteMemoryRaw(addr, value, size, vp);
diff -ruN a/deps/inc/injector/injector.hpp b/deps/inc/injector/injector.hpp
--- a/deps/inc/injector/injector.hpp
+++ b/deps/inc/injector/injector.hpp
@@ -228,6 +228,12 @@
         memory_pointer_tr(void* x)
             : p(memory_pointer(x).get())
         {}  // Constructs from a void pointer, translating the address
+
+        // RavenGun (MinGW-w64): MSVC converted function pointers (FARPROC, hook functions) to void* implicitly.
+        template<class F, class = typename std::enable_if<std::is_pointer<F>::value && std::is_function<typename std::remove_pointer<F>::type>::value>::type>
+        memory_pointer_tr(F x)
+            : p(memory_pointer((void*)x).get())
+        {}
         
         // Just to be method-compatible with basic_memory_pointer ...
         auto_pointer         get()      { return auto_pointer(p);     }
@@ -318,7 +324,7 @@
  *      Writes into memory @addr the content of @value with a sizeof @size
  *      Does memory unprotection if @vp is true
  */
-inline void WriteMemoryRaw(memory_pointer_tr addr, void* value, size_t size, bool vp)
+inline void WriteMemoryRaw(memory_pointer_tr addr, const void* value, size_t size, bool vp)
 {
     scoped_unprotect xprotect(addr, vp? size : 0);
     memcpy(addr.get(), value, size);
diff -ruN a/deps/inc/MinHook.h b/deps/inc/MinHook.h
--- a/deps/inc/MinHook.h
+++ b/deps/inc/MinHook.h
@@ -182,5 +182,17 @@
 
 #ifdef __cplusplus
 }
+
+// RavenGun (MinGW-w64): OpenParrot geeft functiewijzers en adressen rechtstreeks door; MSVC converteerde die stilzwijgend naar
+// LPVOID, GCC en clang niet. Deze sjablonen doen dezelfde reinterpret_cast.
+template <typename T1, typename T2>
+inline MH_STATUS MH_CreateHook(T1 pTarget, T2 pDetour, LPVOID *ppOriginal)
+{ return MH_CreateHook((LPVOID)(uintptr_t)pTarget, (LPVOID)(uintptr_t)pDetour, ppOriginal); }
+template <typename T>
+inline MH_STATUS MH_CreateHookApi(LPCWSTR pszModule, LPCSTR pszProcName, T pDetour, LPVOID *ppOriginal)
+{ return MH_CreateHookApi(pszModule, pszProcName, (LPVOID)(uintptr_t)pDetour, ppOriginal); }
+template <typename T>
+inline MH_STATUS MH_EnableHook(T pTarget)
+{ return MH_EnableHook((LPVOID)(uintptr_t)pTarget); }
 #endif
 
