diff -ruN a/OpenParrot/src/Functions/Ring_amLib/amJvs.cpp b/OpenParrot/src/Functions/Ring_amLib/amJvs.cpp
--- a/OpenParrot/src/Functions/Ring_amLib/amJvs.cpp	2026-10-12 12:20:03.516170275 +0200
+++ b/OpenParrot/src/Functions/Ring_amLib/amJvs.cpp	2026-10-12 12:20:48.041269486 +0200
@@ -131,6 +131,23 @@
 HANDLE touchHandle = (HANDLE)-1;
 bool touchTaken = false;
 
+// RavenGun 0005: Luigi's Mansion Arcade. De gesloten TeknoParrot-kern blokkeert voor deze game elke
+// COM-poort-open (string "BLOCKING LUIGI COM PORT") en geeft FILE_NOT_FOUND terug. Op onze kern ging
+// COM1/COM2 door naar Wine (/dev/ttySx), dat ACCESS_DENIED gaf, en de game sloot met exitcode 32. We
+// bootsen de kern na: elke naam die (na een eventueel "\\.\"-voorvoegsel) met "COM" begint, weigeren.
+static bool rgIsComA(LPCSTR s)
+{
+	if (!s) return false;
+	if (s[0] == '\\' && s[1] == '\\' && s[2] == '.' && s[3] == '\\') s += 4;
+	return (s[0] == 'C' || s[0] == 'c') && (s[1] == 'O' || s[1] == 'o') && (s[2] == 'M' || s[2] == 'm');
+}
+static bool rgIsComW(LPCWSTR s)
+{
+	if (!s) return false;
+	if (s[0] == L'\\' && s[1] == L'\\' && s[2] == L'.' && s[3] == L'\\') s += 4;
+	return (s[0] == L'C' || s[0] == L'c') && (s[1] == L'O' || s[1] == L'o') && (s[2] == L'M' || s[2] == L'm');
+}
+
 HANDLE __stdcall Hook_CreateFileA(LPCSTR lpFileName,
 	DWORD dwDesiredAccess,
 	DWORD dwShareMode,
@@ -139,6 +156,11 @@
 	DWORD dwFlagsAndAttributes,
 	HANDLE hTemplateFile)
 {
+	if (GameDetect::currentGame == GameID::LuigisMansion && rgIsComA(lpFileName))
+	{
+		SetLastError(ERROR_FILE_NOT_FOUND);
+		return INVALID_HANDLE_VALUE;
+	}
 #ifdef _M_AMD64
 	if (GameDetect::currentGame == GameID::WMMT6)
 	{
@@ -259,6 +281,11 @@
 	DWORD dwFlagsAndAttributes,
 	HANDLE hTemplateFile)
 {
+	if (GameDetect::currentGame == GameID::LuigisMansion && rgIsComW(lpFileName))
+	{
+		SetLastError(ERROR_FILE_NOT_FOUND);
+		return INVALID_HANDLE_VALUE;
+	}
 #ifdef _M_AMD64
 	if (GameDetect::currentGame == GameID::WMMT6)
 	{
diff -ruN a/OpenParrot/src/Utility/GameDetect.cpp b/OpenParrot/src/Utility/GameDetect.cpp
--- a/OpenParrot/src/Utility/GameDetect.cpp	2026-10-12 12:20:03.514764805 +0200
+++ b/OpenParrot/src/Utility/GameDetect.cpp	2026-10-12 12:23:28.262397338 +0200
@@ -886,6 +886,9 @@
 		case 0x7e804704:
 			SetGameId(GameID::AmAuthD64, "AMAuthd for WMMT6");
 			break;
+		case 0xd3dc9603: // Luigi's Mansion Arcade (VACUUM.exe)
+			SetGameId(GameID::LuigisMansion, "LuigisMansion");
+			break;
 #endif
 		default:
 			// RavenGun: een game die deze kern NIET herkent wordt niet meer geweigerd.
diff -ruN a/OpenParrot/src/Utility/GameID.h b/OpenParrot/src/Utility/GameID.h
--- a/OpenParrot/src/Utility/GameID.h	2026-09-11 14:23:52.000000000 +0200
+++ b/OpenParrot/src/Utility/GameID.h	2026-10-12 12:20:08.506665665 +0200
@@ -146,5 +146,6 @@
 	HauntedMuseum2101J,
 	GaiaAttack4,
 	Friction,
-	CrazySpeed
+	CrazySpeed,
+	LuigisMansion
 };
