diff -ruN a/OpenParrot/src/Utility/Utils.cpp b/OpenParrot/src/Utility/Utils.cpp
--- a/OpenParrot/src/Utility/Utils.cpp	2026-10-12 22:56:05.376738876 +0200
+++ b/OpenParrot/src/Utility/Utils.cpp	2026-10-12 22:56:34.015699622 +0200
@@ -31,6 +31,59 @@
 #endif
 }
 
+// RavenGun 0006: opt-in init-trace (RG_INIT_TRACE=<bestand>). Elke regel wordt meteen weggeschreven en het
+// bestand weer gesloten, zodat de laatste regel blijft staan als het proces daarna blijft hangen of verdwijnt.
+static char rgTracePath[MAX_PATH];
+static int rgTraceState; // 0 = nog niet bekeken, 1 = aan, 2 = uit
+
+static bool rgTraceEnabled()
+{
+	if (rgTraceState == 0)
+	{
+		const DWORD n = GetEnvironmentVariableA("RG_INIT_TRACE", rgTracePath, MAX_PATH);
+		rgTraceState = (n > 0 && n < MAX_PATH) ? 1 : 2;
+	}
+	return rgTraceState == 1;
+}
+
+unsigned long long rgInitTraceOffset(const void* address)
+{
+	HMODULE self = nullptr;
+	if (!GetModuleHandleExA(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+			reinterpret_cast<LPCSTR>(&rgInitTraceOffset), &self) || self == nullptr)
+		return 0;
+	return static_cast<unsigned long long>(reinterpret_cast<const char*>(address) - reinterpret_cast<const char*>(self));
+}
+
+void rgInitTrace(const char* format, ...)
+{
+	if (!rgTraceEnabled())
+		return;
+
+	char line[512];
+	int used = _snprintf(line, sizeof(line), "[%10lu ms] tid %5lu  ", GetTickCount(), GetCurrentThreadId());
+	if (used < 0)
+		return;
+	va_list args;
+	va_start(args, format);
+	int more = _vsnprintf(line + used, sizeof(line) - used - 3, format, args);
+	va_end(args);
+	if (more < 0)
+		more = static_cast<int>(sizeof(line)) - used - 3;
+	used += more;
+	line[used++] = '\r';
+	line[used++] = '\n';
+
+	HANDLE file = CreateFileA(rgTracePath, FILE_APPEND_DATA, FILE_SHARE_READ | FILE_SHARE_WRITE, nullptr,
+		OPEN_ALWAYS, FILE_ATTRIBUTE_NORMAL, nullptr);
+	if (file == INVALID_HANDLE_VALUE)
+		return;
+	DWORD written = 0;
+	WriteFile(file, line, static_cast<DWORD>(used), &written, nullptr);
+	FlushFileBuffers(file);
+	CloseHandle(file);
+}
+
 int strcmp(const char* str1, const char* str2, bool csensitive)
 {
 	return (csensitive ? ::strcmp(str1, str2) : ::_stricmp(str1, str2));
