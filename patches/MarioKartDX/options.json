      "type": "int",
      "min": 0,
      "max": 30000,
      "default": 3000,
      "target": {
        "kind": "launch_env",
        "file": "UserProfiles/MKDX118.env",
        "name": "TP_POSTSTART_REMOTETHREAD_MS"
      },
      "description_en": "Start the game first and inject the TeknoParrot core after this many milliseconds. Needed under Wine because the default injection cannot read the module list of a paused process.",
