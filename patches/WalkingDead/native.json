{
  "title": "The Walking Dead (Raw Thrills)",
  "enabled": true,
  "status": "niet-getest",
  "arch": "i386",
  "loader": "rg-elfloader",
  "launcher": "gamescope",
  "mounts": [
    {
      "src": "@nas/Walking Dead",
      "dst": "/pm",
      "mode": "overlay"
    }
  ],
  "files": [
    {
      "src": "@patches/WalkingDead/dropin/eerste-plt-slots.tsv",
      "dst": "/rg/wd-slots.tsv"
    },
    {
      "src": "@patches/WalkingDead/dropin/hasp-haken.ini",
      "dst": "/rg/hasp-haken.ini"
    },
    {
      "src": "@patches/WalkingDead/heap.tsv",
      "dst": "/rg/heap.tsv"
    }
  ],
  "seed": [
    {
      "src": "@patches/WalkingDead/dropin/ravengun-hasp",
      "dst": "/pm/ravengun-hasp"
    },
    {
      "src": "@patches/WalkingDead/private/ravengun-hasp-responses",
      "dst": "/pm/ravengun-hasp-responses"
    },
    {
      "src": "@patches/WalkingDead/data/adj/playerCost/freeplay.0.txt",
      "dst": "/pm/g6/walkingdead/pmuser/adj/save/playerCost/freeplay.0.txt"
    },
    {
      "src": "@patches/WalkingDead/data/adj/playerCost/freeplay.1.txt",
      "dst": "/pm/g6/walkingdead/pmuser/adj/save/playerCost/freeplay.1.txt"
    },
    {
      "src": "@patches/WalkingDead/data/adj/playerCost/freeplay.2.txt",
      "dst": "/pm/g6/walkingdead/pmuser/adj/save/playerCost/freeplay.2.txt"
    },
    {
      "src": "@patches/WalkingDead/data/aud/mountedGun0Calibration.0.xml",
      "dst": "/pm/g6/walkingdead/pmuser/aud/save/mountedGun0Calibration.0.xml"
    },
    {
      "src": "@patches/WalkingDead/data/aud/mountedGun0Calibration.1.xml",
      "dst": "/pm/g6/walkingdead/pmuser/aud/save/mountedGun0Calibration.1.xml"
    },
    {
      "src": "@patches/WalkingDead/data/aud/mountedGun0Calibration.2.xml",
      "dst": "/pm/g6/walkingdead/pmuser/aud/save/mountedGun0Calibration.2.xml"
    },
    {
      "src": "@patches/WalkingDead/data/aud/mountedGun1Calibration.0.xml",
      "dst": "/pm/g6/walkingdead/pmuser/aud/save/mountedGun1Calibration.0.xml"
    },
    {
      "src": "@patches/WalkingDead/data/aud/mountedGun1Calibration.1.xml",
      "dst": "/pm/g6/walkingdead/pmuser/aud/save/mountedGun1Calibration.1.xml"
    },
    {
      "src": "@patches/WalkingDead/data/aud/mountedGun1Calibration.2.xml",
      "dst": "/pm/g6/walkingdead/pmuser/aud/save/mountedGun1Calibration.2.xml"
    }
  ],
  "libs": [
    "@lib32/libcsv.so",
    "@lib32/libssl.so.1.0.0",
    "@lib32/libcrypto.so.1.0.0",
    "@lib32/libGLU.so.1",
    "@build/lib32/libcaca.so.0",
    "@build/lib32/librg-threadprio.so",
    "@build/lib32/librg_rio_bridge.so",
    "@build/lib32/librg-glslfix.so",
    "@patches/WalkingDead/dropin/libravengun-hasphook.so",
    "@patches/WalkingDead/dropin/ravengun-hasp.so"
  ],
  "preload": "/rg/lib/libravengun-hasphook.so:/rg/lib/librg-threadprio.so:/rg/lib/librg_rio_bridge.so:/rg/lib/librg-glslfix.so",
  "env": {
    "RG_ELF_SLOT_TABLE": "/rg/wd-slots.tsv",
    "RG_ELF_MAIN": "1",
    "RG_ELF_HEAP_TABLE": "/rg/heap.tsv",
    "RAVENGUN_HASP_GAME": "WalkingDead",
    "RAVENGUN_HASP_DIR": "/pm/ravengun-hasp",
    "RAVENGUN_HASP_ELF_LIB": "/rg/lib/ravengun-hasp.so",
    "RAVENGUN_HASP_ELF_ADRESLIJST": "/rg/hasp-haken.ini",
    "RAVENGUN_HASP_VERBOSE": "1",
    "RG_RIO_LOG": "1",
    "RG_ELF_PTRACER_ANY": "1",
    "RG_GLSLFIX_LOG": "1"
  },
  "exe": "/pm/game",
  "cwd": "/pm",
  "home": "/pm",
  "args": [
    "-f{res}",
    "-e"
  ],
  "res": "1920x1080",
  "route": "tp-shm",
  "extra_ro": [
    "/dev/shm/ravengun_JvsState"
  ],
  "note": "2026-10-17: native attract proven (five minutes, same PID). The HASP answers are local reference answers kept in the write layer, not shipped. 2026-10-22: the mounted crossbows (aim, trigger, reload lever) turned out to be on the UMC board (/dev/umc), not on the RIO board; the RIO bridge now answers as the UMC board (rio-invoer.ini). Free play and both gun calibrations are seeded from patches/WalkingDead/data (made with the game's own Adjustments and calibration screens), so the game boots straight to attract. Play with the PS Move not yet confirmed by the owner."
}
