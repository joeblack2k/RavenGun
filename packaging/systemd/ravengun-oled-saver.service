# OLED-bescherming: zwart scherm met bewegend klokje als er 10 minuten geen game draait (scripts/oled-saver.sh).
[Unit]
Description=RavenGun OLED-bescherming
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/projects/ravengun/scripts/oled-saver.sh --loop
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
