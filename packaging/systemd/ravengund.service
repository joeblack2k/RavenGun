# Gebruikersservice voor ravengund (geen root). Installeren: scripts/install-service.sh
[Unit]
Description=RavenGun daemon (PS Move naar virtuele lightgun)
After=graphical-session.target bluetooth.target

[Service]
Type=simple
WorkingDirectory=%h/projects/ravengun
ExecStart=%h/projects/ravengun/build/ravengund --web-lan
Restart=on-failure
RestartSec=2
StandardOutput=append:%h/.local/state/ravengun/logs/ravengund.log
StandardError=inherit

[Install]
WantedBy=graphical-session.target
