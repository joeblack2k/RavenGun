# OLED-bescherming: zwart scherm met bewegend klokje als er 10 minuten geen game draait (src/app/core/SaverLoop.cpp).
# Sjabloon: scripts/install-user.sh vult @BINDIR@ in (<prefix>/bin met de app `ravengun`).
[Unit]
Description=RavenGun OLED-bescherming
After=graphical-session.target

[Service]
Type=simple
ExecStart=@BINDIR@/ravengun --saver-loop
ExecStopPost=@BINDIR@/ravengun --saver-stop-view
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
