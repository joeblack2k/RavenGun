# Gebruikersservice voor ravengund (geen root). Sjabloon: de app (src/app/core/Install.cpp) vult @BINDIR@ in
# (de map met ravengund: <prefix>/bin of <repo>/build) en schrijft het resultaat naar ~/.config/systemd/user/ravengund.service.
[Unit]
Description=RavenGun daemon (PS Move naar virtuele lightgun)
After=graphical-session.target bluetooth.target

[Service]
Type=simple
WorkingDirectory=%h
ExecStart=@BINDIR@/ravengund
Restart=on-failure
RestartSec=2
StandardOutput=append:%h/.local/state/ravengun/logs/ravengund.log
StandardError=inherit

[Install]
WantedBy=graphical-session.target
