# Geen gamebestanden, proprietary runtimes, credentials of logs in Git
*.so
*.so.*
*.exe
*.dll
/runtime/
/logs/
/state/
*.log
.env
secrets*
*.key

# CMake-builds
/build/
/build-app/
/build-app-asan/
src/tools/movetest/movetest
/.claude/
/dist/
__pycache__/

# De drop-in-bibliotheken van een game zijn geen bouwafval maar de levering zelf: een verse kloon
# moet kunnen draaien zonder dat er eerst iets gebouwd wordt. De bron staat in hasp/, matrix/ en
# tools/rt-glfix/; scripts/build-*.sh zet het resultaat in de dropin/-map van elke game die het in
# dropin.ini noemt. Zonder deze uitzondering mist een kloon elk bestand waar dropin.ini naar wijst.
!patches/*/dropin/**

# Meegeleverde profielen en eigen drop-ins horen bij deze repository.
# Privégegevens uit de oude patchescheckout blijven lokaal; nooit toevoegen aan Git.
/patches/**/ravengun-hasp/
/patches/**/memory/
/patches/**/dongle.json
/patches/**/dongle.*.json
/patches/**/data/shaders/
/patches/**/dropin/SAVE/
/patches/**/heap.tsv
# Deze eigen DLL bevat een game-afgeleide ontsleutelde importtabel.
/patches/**/WkWin32.dll
/patches/FarCryParadiseLost/dropin/systemcfg.lua
/patches/FarCryParadiseLost/dropin/Systemcfgoverride.lua
/patches/FarCryParadiseLost/dropin/Arcade_Calibration.txt
# Eigen gebouwde FMOD-host; niet de proprietary FMOD-bibliotheken.
!/patches/Halo/data/fmod/rg-fmod-host.exe
build-saver/
