;
; The ordinals Shell.exe imports from DK2WIN32.dll (its import table has names for none of them):
;   4  0x459034   10 0x459038   13 0x45902c   17 0x459024   20 0x459028   24 0x459020   25 0x459030
; NONAME: exported by ordinal only, exactly like the closed runtime.
LIBRARY DK2WIN32
EXPORTS
    dk2_driver_present@0  @4  NONAME
    dk2_read_memory@24   @10  NONAME
    dk2_unused@0         @13  NONAME
    dk2_error_state@0    @17  NONAME
    dk2_find_key@8       @20  NONAME
    dk2_error_text@8     @24  NONAME
    dk2_error_text_ptr@4 @25  NONAME
